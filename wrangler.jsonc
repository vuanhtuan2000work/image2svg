{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "image2svg-convert",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-06-29",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
